# Copy to .env.local and adjust. Every variable is optional in development.

# ── Which backend the browser talks to ────────────────────────────────────────
# Leave unset (or "/api") to use the built-in Next.js API routes (default).
# Set to the FastAPI server to use the Python backend instead:
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Signaling transport: "http" (SSE + POST, built-in API) or "websocket"
# (FastAPI /ws hub). Inferred from NEXT_PUBLIC_API_URL when unset.
# NEXT_PUBLIC_SIGNALING=http

# Optional endpoint returning {"iceServers": [...]} (e.g. TURN credentials).
# NEXT_PUBLIC_ICE_SERVERS_ENDPOINT=https://example.com/ice

# ── Built-in API (Next.js route handlers) ─────────────────────────────────────
# REQUIRED in production: HMAC secret for auth tokens. Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=

# Access-token lifetime in seconds (default 7 days).
# AUTH_TOKEN_TTL_SECONDS=604800

# Admin account created when the database is first seeded. In development a
# default admin (admin@gmail.com / admin123) is used if these are unset; in
# production no admin is created unless both are set.
# DUROTTO_ADMIN_EMAIL=admin@example.com
# DUROTTO_ADMIN_PASSWORD=

# Seed the demo@durotto.app / demo1234 account in development (set 0 to skip).
# DUROTTO_SEED_DEMO=1

# Storage locations (defaults: .data/db.json and .data/uploads).
# DUROTTO_DB_PATH=
# DUROTTO_UPLOADS_DIR=

# Max upload size in bytes (default 100 MB).
# DUROTTO_MAX_UPLOAD_BYTES=104857600

# Trust X-Forwarded-For for client IPs (only behind a proxy that sets it).
# TRUST_PROXY=1

# Origin allowed by the API's CORS header (only needed for cross-origin callers).
# ALLOWED_ORIGINS=http://localhost:3000
