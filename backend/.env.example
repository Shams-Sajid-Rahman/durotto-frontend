# Copy to .env and adjust.

# REQUIRED when ENV=production. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
# "production" makes a missing SECRET_KEY a startup error.
ENV=development

DATABASE_URL=sqlite:///./durotto.db
# Comma-separated; "*" is ignored (credentials are allowed, so origins must be explicit).
ALLOWED_ORIGINS=http://localhost:3000
UPLOADS_DIR=./uploads
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# slowapi rate-limit strings; RATE_LIMIT_ENABLED=0 turns limiting off.
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_JOIN_CODE=10/minute
RATE_LIMIT_ENABLED=1
